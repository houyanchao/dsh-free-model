{
  "name": "dsh-open-model",
  "version": "1.1.0",
  "description": "安装后，无需注册或登录，即可在 DSH 中使用免费 AI 模型。连接 ChatGPT 账号后，还能直接使用已有套餐的额度。",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houyanchao/dsh-open-model.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#openmodel-models": "./models.json"
  },
  "files": [
    "dist",
    "models.json",
    "LICENSE",
    "native/credential-key",
    "cordis.patch.yml",
    "notices"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-native.mjs",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "openai": "7.21.0",
    "proper-lockfile": "4.1.2"
  },
  "overrides": {
    "graceful-fs": "4.2.11"
  }
}
